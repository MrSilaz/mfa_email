{
    "name": "ralffreit/mfa-email",
    "type": "typo3-cms-extension",
    "description": "E-Mail MFA Provider: provides multi-factor authentication via e-mail for the TYPO3 backend.",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "typo3", "email", "mfa", "2fa", "authentication", "security"
    ],
    "authors": [
        {
            "name": "Ralf Freit",
            "email": "ralf@freit.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/MrSilaz/mfa_email/issues",
        "source": "https://github.com/MrSilaz/mfa_email/"
    },
    "version": "3.0.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "Ralffreit\\MfaEmail\\": "Classes"
        }
    },
    "replace": {
        "typo3-ter/mfa-email": "self.version"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mfa_email",
            "version": "3.0.0",
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/public",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
